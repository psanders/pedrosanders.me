                  "descendants": {
                    "bwRS4": {
                      "content": "Do you write code, or just advise?"
                    },
                    "fHsmD": {
                      "content": "Primarily I set and de-risk direction — that's where I'm worth the most to you. Hands-on implementation is on the table when the scope warrants it, and it's priced in."
                    }
                  }
                },
                {
                  "id": "AMhR6",
                  "type": "ref",
                  "ref": "SCHsw",
                  "name": "Q 2",
                  "width": "fill_container",
                  "descendants": {
                    "bwRS4": {
                      "content": "How long?"
                    },
                    "fHsmD": {
                      "content": "Typically 8–12 weeks, fixed scope. Some extend."
                    }
                  }
                },
                {
                  "id": "TAzrM",
                  "type": "ref",
                  "ref": "SCHsw",
                  "name": "Q 3",
                  "width": "fill_container",
                  "descendants": {
                    "bwRS4": {
                      "content": "Can you start next week?"
                    },
                    "fHsmD": {
                      "content": "Rarely — I run one or two at a time. The conversation is how we find the slot."
                    }
                  }
                }
              ]
            }
