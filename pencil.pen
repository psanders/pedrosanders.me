                {
                  "type": "text",
                  "id": "c0f66g",
                  "fill": "#053204ff",
                  "content": "Hi. I'm Pedro.",
                  "lineHeight": 1.05,
                  "fontFamily": "Poppins",
                  "fontSize": 48,
                  "fontWeight": "700",
                  "letterSpacing": -1.2
                },
                {
                  "type": "frame",
