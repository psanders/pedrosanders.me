            {
              "type": "frame",
              "id": "V4htHk",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 22,
              "children": [
                {
                  "type": "text",
                  "id": "D7KVc",
                  "fill": "#053204ff",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "For 15 years I've worked at the edge of communications infrastructure: SIP, RTP, media servers, and now Voice AI. I built Routr and Fonoster because the voice stack deserved better tooling.",
                  "lineHeight": 1.25,
                  "fontFamily": "Poppins",
                  "fontSize": 30,
                  "fontWeight": "600",
                  "letterSpacing": -0.5
                },
                {
                  "type": "text",
                  "id": "sw9Kd",
                  "fill": "#3a4a3a",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "But infrastructure claims are cheap. So we became our own customer: Qcobro, our vertical AI for collections, runs on Fonoster in production. Real calls, real money, real failure modes. That's where everything I publish comes from.",
                  "lineHeight": 1.55,
                  "fontFamily": "Poppins",
                  "fontSize": 16,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "wgH64",
                  "fill": "#3a4a3a",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The goal is simple: make Fonoster the standard for how Voice AI gets built.",
                  "lineHeight": 1.55,
                  "fontFamily": "Poppins",
                  "fontSize": 16,
                  "fontWeight": "500"
                },
                {
                  "type": "frame",
                  "id": "ELuwK",
